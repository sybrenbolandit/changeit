<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%magenta(%-5level) -%kvp- %green(%msg%n)</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.sshd" level="WARN" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>